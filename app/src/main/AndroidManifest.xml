<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 集中用の環境音（雨音）をバックグラウンドで鳴らすフォアグラウンドサービス -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 端末再起動でリマインダ再設定（事例⑥ BroadcastReceiver の舞台） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".app.DorodoroApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DorodoroTimer"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DorodoroTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dorodoro" android:host="stats" />
            </intent-filter>
        </activity>

        <!-- 集中用の環境音（雨音）ループ再生。FGSの教科書的ユースケース（mediaPlayback）。 -->
        <service
            android:name=".service.AmbientSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- タイマー終了アラームの受け口（AlarmManager → 終了通知）。exported=false。 -->
        <receiver
            android:name=".service.TimerAlarmReceiver"
            android:exported="false" />

    </application>

</manifest>
