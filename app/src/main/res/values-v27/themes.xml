<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowLightNavigationBar は API 27 以降。明るいナビゲーションバーの上で
         ジェスチャーハンドル／戻るボタンが白のまま消えるのを防ぐ。 -->
    <style name="Theme.DorodoroTimer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/warm_background</item>
        <item name="android:statusBarColor">@color/warm_background</item>
        <item name="android:navigationBarColor">@color/warm_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
