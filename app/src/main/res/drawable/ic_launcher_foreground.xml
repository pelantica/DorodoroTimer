<?xml version="1.0" encoding="utf-8"?>
<!-- アダプティブアイコンの前景。今までの時計をそのまま白にしたもの。
     元の時計は 24x24 の座標系で描かれているので、group でアダプティブの
     108x108 に拡大し、マスクで欠けない中央 72x72 のセーフゾーンに収めている。
     translate は文字盤の中心 (12, 12) が (54, 54) に来る値＝54 - 12 * scale。
     scale は文字盤の直径が 20 * 2.6 = 52（セーフゾーン 72 の 7 割）になる大きさ。
     これ以上大きくすると円マスクで上のつまみが欠ける。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.6"
        android:scaleY="2.6"
        android:translateX="22.8"
        android:translateY="22.8">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12,2A10,10 0,1 0,22 12A10,10 0,0 0,12 2ZM12,20A8,8 0,1 1,20 12A8,8 0,0 1,12 20Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M12.5,7L11,7v6l5.2,3.1l0.8,-1.3l-4.5,-2.7z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M9,1h6v2h-6z" />
    </group>
</vector>
