# リリース署名（アップロード鍵）の設定。
# このファイルは雛形。実際の値は keystore.properties にコピーして書く（gitignore 済み・コミットされない）。
#
# 鍵本体はリポジトリ外に置く: ~/keystores/dorodoro-upload.jks
# storeFile はホーム相対の絶対パスで書く（例: /Users/あなた/keystores/dorodoro-upload.jks）。
#
# storePassword と keyPassword は keytool 生成時に設定したもの（本手順ではストアと鍵で同一）。
# Play App Signing 前提なので、これは「アップロード鍵」。万一失っても Google に再登録申請できる。

storeFile=/Users/CHANGEME/keystores/dorodoro-upload.jks
storePassword=CHANGEME
keyAlias=dorodoro-upload
keyPassword=CHANGEME
